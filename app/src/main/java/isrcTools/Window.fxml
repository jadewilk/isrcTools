<?xml version="1.0" encoding="UTF-8"?>

<?import java.net.*?>
<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<GridPane fx:controller="isrcTools.RootController"
  xmlns:fx="http://javafx.com/fxml" alignment="center" hgap="10" vgap="10">
  <padding>
    <Insets top="25" right="25" bottom="10" left="25"/>
  </padding>
  <Text text="Playlist Transfer Tool"
    GridPane.columnIndex="0" GridPane.rowIndex="0"
    GridPane.columnSpan="2"/>

  <Label text="Playlist source:"
    GridPane.columnIndex="0" GridPane.rowIndex="1"/>

  <ComboBox fx:id="source"
    GridPane.columnIndex="1" GridPane.rowIndex="1"
    onAction="#changeSource"
  />

  <ListView fx:id="sourcePlaylistList" GridPane.columnIndex="0" GridPane.rowIndex="2"
    onMouseClicked="#changeSourcePlaylist"
  >
  </ListView>

  <Label text="Playlist destination:"
    GridPane.columnIndex="3" GridPane.rowIndex="1"/>

  <ComboBox fx:id="destination" 
    GridPane.columnIndex="4" GridPane.rowIndex="1"
    onAction="#changeDestination"
  />

  <ListView fx:id="destinationPlaylistList" GridPane.columnIndex="3" GridPane.rowIndex="2"
    onMouseClicked="#changeDestinationTrack"
  >
    <ListCell />
  </ListView>


  <HBox spacing="10" alignment="bottom_right"
    GridPane.columnIndex="2" GridPane.rowIndex="8">
    <Button text="Copy them!"
      onAction="#executeTransfer"
    />
  </HBox>

</GridPane>
